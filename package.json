{
  "name": "folio-markdown-viewer",
  "version": "1.2.0",
  "description": "Folio — an offline Markdown reader and editor with rich diagrams, dialect profiles and portable exports.",
  "author": "Alex",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.js tests/*.test.cjs",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "package": "npm run build && electron-builder --win portable nsis --x64",
    "release:assemble": "python scripts/assemble-release.py",
    "test:editor": "node tests/editor-smoke.cjs",
    "test:pdf": "node tests/pdf-smoke.cjs"
  },
  "build": {
    "appId": "personal.folio.markdown",
    "productName": "Folio",
    "artifactName": "Folio-${version}-${arch}-${target}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Folio-${version}-Setup-x64.exe"
    },
    "portable": {
      "artifactName": "Folio-${version}-win-x64.exe"
    },
    "extraFiles": [
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.folio.txt"
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "docs/licensing.md",
        "to": "THIRD_PARTY_SOURCES.md"
      }
    ]
  },
  "devDependencies": {
    "@viz-js/viz": "3.30.0",
    "dompurify": "3.4.15",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "highlight.js": "11.12.0",
    "jsdom": "30.0.1",
    "katex": "0.18.7",
    "markdown-it": "15.0.2",
    "markdown-it-abbr": "2.0.0",
    "markdown-it-attrs": "5.0.1",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "markdown-it-task-lists": "2.1.1",
    "markdown-it-texmath": "1.0.0",
    "mermaid": "11.17.2",
    "playwright": "1.63.0",
    "vite": "8.3.0",
    "yaml": "2.9.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GitKama/folio.git"
  },
  "homepage": "https://github.com/GitKama/folio#readme",
  "bugs": {
    "url": "https://github.com/GitKama/folio/issues"
  }
}
