{
  "name": "folio-markdown-viewer",
  "version": "2.0.0",
  "description": "Folio — an offline Markdown reader and editor with rich diagrams, dialect profiles and portable exports.",
  "author": "Alex",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "tauri dev",
    "test": "node --test tests/engine.test.js tests/pdf-profiles.test.js tests/teams-export.test.js",
    "test:desktop": "node tests/native-smoke.cjs",
    "package": "tauri build",
    "release:assemble": "python scripts/assemble-release.py",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:native-build": "npm run build && cargo build --manifest-path src-tauri/Cargo.toml --features custom-protocol,test-harness"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@viz-js/viz": "3.30.0",
    "dompurify": "3.4.17",
    "esbuild": "0.28.1",
    "highlight.js": "11.12.0",
    "jsdom": "30.0.1",
    "katex": "0.18.7",
    "markdown-it": "15.0.3",
    "markdown-it-abbr": "2.0.0",
    "markdown-it-attrs": "5.0.1",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "markdown-it-task-lists": "2.1.1",
    "markdown-it-texmath": "1.0.0",
    "mermaid": "12.2.0",
    "playwright": "1.63.0",
    "vite": "8.3.5",
    "yaml": "2.9.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GitKama/folio.git"
  },
  "homepage": "https://github.com/GitKama/folio#readme",
  "bugs": {
    "url": "https://github.com/GitKama/folio/issues"
  }
}
